# これはテンプレートです。実ファイルは .streamlit/secrets.toml にコピーして使用（gitには含めない）。
# Streamlit Community Cloud では、この内容をアプリの Settings → Secrets に貼り付けます。
APP_PASSWORD = "ここに好きなパスワード"

# 単価マスタ（ロット別単価マスタ）を読む GAS ウェブアプリ
MASTER_GAS_URL = "https://script.google.com/macros/s/（ウェブアプリのID）/exec"
MASTER_GAS_TOKEN = "（単価マスタのGASの合言葉）"

# 得意先ごと出荷一覧表に登録する GAS ウェブアプリ（一覧表のスプレッドシートに紐付けたもの）
# 合言葉は一覧表のGASで setup() を実行すると実行ログに出る。未設定なら登録せず、画面に赤で表示する
ICHIRAN_GAS_URL = "https://script.google.com/macros/s/（ウェブアプリのID）/exec"
ICHIRAN_GAS_TOKEN = "（一覧表のGASの合言葉）"
